# Visual Studio / MSBuild intermediates for native/KH1NativeDebug.
# The actual build output (scripts/io_packages/kh1_native_debug.dll) is
# committed -- only the throwaway intermediate build tree is ignored here.
native/**/x64/
native/**/.vs/
native/**/*.obj
native/**/*.pdb
native/**/*.ilk
native/**/*.iobj
native/**/*.ipdb
native/**/*.lib
native/**/*.exp
native/**/*.tlog
native/**/*.recipe
native/**/*.pch

# Python bytecode. tools/slotmap.py is normally run as a script, but importing it
# (as the ad-hoc analysis one-liners do) makes CPython cache a .pyc next to it.
__pycache__/
*.py[cod]
